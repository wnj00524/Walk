; Purpose: Defines the smallest runnable Endless Nature Godot project.
; Why: Keeping startup settings in text makes the prototype reproducible without editor clicks.
; Reads: The main scene stored at res://scenes/main.tscn.
; Writes: Nothing; Godot reads this file when importing or launching the project.
; Safe changes: Window width, height, and stretch settings are presentation-only at this stage.
; Failure: An invalid main-scene path prevents startup and is reported by Godot.

config_version=5

[application]

config/name="Endless Nature"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6")

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.065, 1)
