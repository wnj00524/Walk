; Purpose: Defines the reusable first-person body used by the walking prototype.
; Why: A scene keeps the camera height and collision shape consistent when the world grows.
; Reads: res://src/player/walker.gd for movement, look, and cursor behaviour.
; Writes: Runtime nodes only; no save data or world state is created here.
; Safe changes: Camera height and capsule size can be tuned for comfort with matching tests.
; Failure: Missing shape, camera, or script resources prevent the player from starting.

[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://src/player/walker.gd" id="1_walker"]

[sub_resource type="CapsuleShape3D" id="CapsuleShape_player"]
radius = 0.35
height = 1.8

[sub_resource type="CapsuleMesh" id="CapsuleMesh_marker"]
radius = 0.35
height = 1.8

[node name="Walker" type="CharacterBody3D"]
script = ExtResource("1_walker")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
position = Vector3(0, 0.9, 0)
shape = SubResource("CapsuleShape_player")

[node name="PrototypeBodyMarker" type="MeshInstance3D" parent="."]
visible = false
position = Vector3(0, 0.9, 0)
mesh = SubResource("CapsuleMesh_marker")

[node name="Camera3D" type="Camera3D" parent="."]
position = Vector3(0, 1.65, 0)
current = true
