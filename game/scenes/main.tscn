[node name="StartMarker" type="MeshInstance3D" parent="."]
position = Vector3(0, 0.5, -5)
mesh = SubResource("BoxMesh_marker")
material_override = SubResource("Material_marker")

[node name="Walker" parent="." instance=ExtResource("1_player")]
position = Vector3(0, 0.1, 5)

