; Purpose: Provides the labelled, simple test floor for T005's first-person walking check.
; Why: A bounded fixture makes look, walk, and cursor release reviewable before real terrain.
; Reads: The reusable player scene and built-in Godot mesh, light, and environment resources.
; Writes: Nothing persistent; all floor, light, and instructional UI nodes are temporary.
; Safe changes: Floor size, daylight colour, and instruction wording are prototype-only.
; Failure: Missing player scene or malformed resources are reported during import or launch.

[gd_scene load_steps=8 format=3]

[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="1_player"]

[sub_resource type="BoxMesh" id="BoxMesh_floor"]
size = Vector3(40, 0.2, 40)

[sub_resource type="BoxShape3D" id="BoxShape_floor"]
size = Vector3(40, 0.2, 40)

[sub_resource type="StandardMaterial3D" id="Material_floor"]
albedo_color = Color(0.22, 0.29, 0.2, 1)
roughness = 0.95

[sub_resource type="Environment" id="Environment_daylight"]
background_mode = 1
background_color = Color(0.48, 0.64, 0.78, 1)
ambient_light_source = 3
ambient_light_color = Color(0.65, 0.75, 0.82, 1)
ambient_light_energy = 0.8

[sub_resource type="StandardMaterial3D" id="Material_marker"]
